{
  "namespace": "es.hispalis.lab.v1",
  "type": "record",
  "name": "HechoDePeticion",
  "doc": "Lo que se publica en `lab.peticiones.v1`. Referencias y nada más: ni nombre, ni NHC, ni códigos de prueba. Quien necesite el dato lo pide a la API FHIR con sus permisos.",
  "fields": [
    {
      "name": "hechoId",
      "type": "string",
      "doc": "UUID del hecho en el `outbox` del laboratorio. Es la clave de idempotencia del consumidor: la entrega es AL MENOS UNA VEZ, así que el mismo `hechoId` puede llegar dos veces y aplicarlo dos veces tiene que dar el mismo resultado que aplicarlo una."
    },
    {
      "name": "tipo",
      "type": {
        "type": "enum",
        "name": "TipoDeHechoDePeticion",
        "doc": "Qué le pasó a la línea. Añadir un símbolo es compatible hacia atrás; quitarlo o renombrarlo, no.",
        "symbols": ["PETICION_REGISTRADA", "LINEA_ANULADA"]
      },
      "doc": "Un hecho ocurrido, no una orden: describe algo que ya pasó y que no se deshace negándose a consumirlo."
    },
    {
      "name": "ocurridoEn",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Cuándo lo apuntó el laboratorio. NO sirve para ordenar entre particiones: el orden lo da la partición, que es el paciente."
    },
    {
      "name": "pacienteId",
      "type": "string",
      "doc": "UUID interno del paciente en este laboratorio, que además es la clave de partición. Nunca el NHC, el DNI ni el NUHSA: son identificadores que la persona lleva encima fuera de aquí."
    },
    {
      "name": "serviceRequestRef",
      "type": "string",
      "doc": "Referencia FHIR de la línea, `ServiceRequest/{uuid}`."
    }
  ]
}
