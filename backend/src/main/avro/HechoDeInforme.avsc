{
  "namespace": "es.hispalis.lab.v1",
  "type": "record",
  "name": "HechoDeInforme",
  "doc": "Lo que se publica en `lab.informes.v1`. Es el hecho del que cuelgan el `ORU^R01` saliente hacia el HIS y, en el hito 3, el notificador EDO. No lleva ni una conclusión ni un resultado: lleva dónde está el informe.",
  "fields": [
    {
      "name": "hechoId",
      "type": "string",
      "doc": "UUID del hecho en el `outbox` del laboratorio. Clave de idempotencia del consumidor: la entrega es al menos una vez."
    },
    {
      "name": "tipo",
      "type": {
        "type": "enum",
        "name": "TipoDeHechoDeInforme",
        "doc": "Qué le pasó al informe. Añadir un símbolo es compatible hacia atrás; quitarlo o renombrarlo, no.",
        "symbols": ["INFORME_EMITIDO"]
      },
      "doc": "Un hecho ocurrido, no una orden."
    },
    {
      "name": "ocurridoEn",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Cuándo lo apuntó el laboratorio. El orden entre hechos lo da la partición, que es el paciente."
    },
    {
      "name": "pacienteId",
      "type": "string",
      "doc": "UUID interno del paciente en este laboratorio, y clave de partición. Nunca el NHC, el DNI ni el NUHSA."
    },
    {
      "name": "diagnosticReportRef",
      "type": "string",
      "doc": "Referencia FHIR del informe, `DiagnosticReport/{uuid}`."
    }
  ]
}
