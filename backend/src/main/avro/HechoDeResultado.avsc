{
  "namespace": "es.hispalis.lab.v1",
  "type": "record",
  "name": "HechoDeResultado",
  "doc": "Lo que se publica en `lab.resultados.v1`. NO lleva la cifra, ni la unidad, ni el código de prueba, ni quién firmó: eso es dato clínico y el bus no es la historia clínica. Lleva dónde mirarlo, y mirarlo pasa por la API con sus permisos.",
  "fields": [
    {
      "name": "hechoId",
      "type": "string",
      "doc": "UUID del hecho en el `outbox` del laboratorio. Clave de idempotencia del consumidor: la entrega es al menos una vez."
    },
    {
      "name": "tipo",
      "type": {
        "type": "enum",
        "name": "TipoDeHechoDeResultado",
        "doc": "`RESULTADO_INFORMADO` es una cifra que todavía no responde nadie; `RESULTADO_VALIDADO` es la que un facultativo ha firmado. Solo la segunda es publicable.",
        "symbols": ["RESULTADO_INFORMADO", "RESULTADO_VALIDADO"]
      },
      "doc": "Un hecho ocurrido, no una orden."
    },
    {
      "name": "ocurridoEn",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Cuándo lo apuntó el laboratorio. El orden entre hechos lo da la partición, que es el paciente: sin eso, una validación podría consumirse antes que el resultado que valida."
    },
    {
      "name": "pacienteId",
      "type": "string",
      "doc": "UUID interno del paciente en este laboratorio, y clave de partición. Nunca el NHC, el DNI ni el NUHSA."
    },
    {
      "name": "observationRef",
      "type": "string",
      "doc": "Referencia FHIR del resultado, `Observation/{uuid}`."
    },
    {
      "name": "specimenRef",
      "type": ["null", "string"],
      "default": null,
      "doc": "Referencia FHIR de la muestra de la que salió, `Specimen/{uuid}`. Solo viene al informar."
    },
    {
      "name": "serviceRequestRef",
      "type": ["null", "string"],
      "default": null,
      "doc": "Referencia FHIR de la línea que lo pidió, `ServiceRequest/{uuid}`. Ausente en una repetición de control o en una determinación que añadió el laboratorio: existen sin que nadie las pidiera por volante."
    },
    {
      "name": "provenanceRef",
      "type": ["null", "string"],
      "default": null,
      "doc": "Referencia FHIR de la firma, `Provenance/{uuid}`. Solo viene al validar. Quién firmó está DENTRO del recurso, no aquí."
    }
  ]
}
