<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backend de HispaLIS: núcleo de dominio + API FHIR R5 + proyección HAPI.

  Sobre las versiones (§12 del diseño):
  · Spring Boot se mantiene en la línea 3.5.x a propósito, no por inercia. HAPI FHIR 8.x va sobre
    Spring Framework 6 y Jakarta EE 10; Spring Boot 4.x salta a Spring Framework 7 y Jakarta EE 11,
    que HAPI todavía no soporta. Subir a 4.x rompería el servidor JPA que sostiene la proyección.
  · La codificación es UTF-8 en todas partes y de forma explícita: MUÑOZ, ÁLVAREZ y PEÑA son casos
    de prueba obligatorios del proyecto, y un `platform default encoding` los corrompe en silencio.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>es.hispalis</groupId>
  <artifactId>hispalis-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>HispaLIS · backend</name>
  <description>Sistema de Información de Laboratorio sobre HL7 FHIR R5</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <hapi-fhir.version>8.10.1</hapi-fhir.version>
    <embedded-postgres.version>2.1.0</embedded-postgres.version>
    <spotless.version>2.44.5</spotless.version>
    <jacoco.version>0.8.13</jacoco.version>

    <!--
      Las serdes de Confluent y el registro de esquemas. La línea 7.9.x es la que va con Kafka 3.9,
      que es la que gestiona Spring Boot 3.5.16: la 8.x salta a Kafka 4.x y dejaría el cliente y el
      serializador en versiones distintas del protocolo. Al subir Spring Boot hay que mover las dos.
    -->
    <confluent.version>7.9.8</confluent.version>

    <!--
      Avro no lo gestiona el BOM de Spring Boot, así que la versión se fija aquí. Es la misma que
      trae `kafka-avro-serializer` 7.9.x, y tiene que serlo: el plugin que genera las clases y la
      librería que las serializa comparten formato, y desalinearlos rompe en ejecución, no al
      compilar.
    -->
    <avro.version>1.11.4</avro.version>

    <!--
      Spring Boot 3.5.16 gestiona commons-lang3 en la 3.17.0 y HAPI 8.10.1 necesita la 3.18.0, que
      es donde aparece `ObjectUtils.getIfNull(T, T)`. Gana el `dependencyManagement` del padre, así
      que hay que subirla aquí a mano.

      No es un fallo de compilación: los dos son compatibles al compilar y el conflicto solo estalla
      en ejecución, con un `NoSuchMethodError` al servir la primera petición. Al actualizar Spring
      Boot, comprobar si ya alcanza a HAPI y quitar esta línea.
    -->
    <commons-lang3.version>3.18.0</commons-lang3.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Modelo FHIR R5 y SOLO R5. Si un import trae `…model.r4…`, está mal (adr-0001, y la tabla
         de §2.1 de docs/diseno.md con los nueve elementos que cambian). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r5</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <!--
      El servidor JPA de HAPI es la proyección de lectura (§9 del diseño): da búsqueda por
      SearchParameter, _include, paginación por Bundle.link, _history, ETag/versionId y $validate.
      Se empotra en esta aplicación —no se usa `hapi-fhir-jpaserver-starter`, que es una aplicación
      aparte— porque la proyección tiene que escribirse en la MISMA transacción que el dominio.
    -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-jpaserver-base</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      El laboratorio es un SERVIDOR DE RECURSOS de OAuth2 y nada más: valida el testigo que le llega
      y no participa en cómo se obtuvo. Por eso `resource-server` y no `oauth2-client`: aquí no hay
      redirecciones, ni canje de códigos, ni sesión de navegador — eso es cosa de la web (ítem 37).

      Lo que aporta es la validación por JWKS con caché y rotación de claves. Escribirla a mano es
      exactamente el tipo de criptografía que no se escribe a mano.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway gobierna el esquema `dominio`. `flyway-core` llega transitivo desde HAPI, pero desde
      Flyway 10 el soporte de cada motor va en su propio artefacto: sin este, aborta el arranque con
      «Unsupported Database: PostgreSQL 14.15», culpando a la base de datos en vez de al módulo.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      El bus de eventos (§11). El relay del `outbox` publica desde aquí, y solo desde aquí: Kafka NO
      alimenta el modelo de lectura —la proyección FHIR se sigue escribiendo síncrona en la
      transacción del dominio— y por eso esto es una dependencia de salida, no de arranque. Con el
      broker caído la API tiene que seguir devolviendo `201`.
    -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!--
      Avro más el serializador que habla con el registro de esquemas. Un tópico sin esquema es un
      `Map<String,Object>` con más pasos: el esquema es el contrato, y las clases del bus se generan
      de los `.avsc` de `src/main/avro` para que ese contrato sea un tipo compilado y no un mapa.
    -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>${avro.version}</version>
    </dependency>

    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <version>${confluent.version}</version>
      <exclusions>
        <!--
          Arrastra un `slf4j-reload4j` que compite con el Logback de Spring Boot: dos enlaces de
          SLF4J en el classpath y el arranque avisa de ello y elige uno al azar.
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-reload4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Kafka de verdad en los tests, en proceso y sin Docker — la misma decisión que el PostgreSQL
      embebido. Hace falta un broker real y no un doble: la prueba que importa es la del broker
      CAÍDO, y un doble en memoria no se cae de la misma manera.
    -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      PostgreSQL de verdad en los tests, arrancado en proceso desde un binario: mismo motor y mismo
      dialecto que producción, sin necesitar Docker. La decisión, en docs/adr/adr-0013.
    -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!--
      Las serdes de Avro contra el registro de esquemas no están en Maven Central: Confluent publica
      solo en su propio repositorio. Es la única razón por la que este `pom` tiene un repositorio
      añadido, y conviene que siga siéndolo.
    -->
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>confluent</id>
      <name>Confluent</name>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Genera las clases del bus a partir de los `.avsc` de `src/main/avro`. El esquema es la
        fuente: escribir la clase a mano y el `.avsc` aparte es tener el contrato dos veces y
        descubrir que divergieron cuando un consumidor no pueda leer.
      -->
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <configuration>
          <stringType>String</stringType>
          <!-- Los `.avsc` se registran y se validan tal cual se escriben; sin reordenar campos. -->
          <enableDecimalLogicalType>true</enableDecimalLogicalType>
        </configuration>
        <executions>
          <execution>
            <id>generar-clases-del-bus</id>
            <goals>
              <goal>schema</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        El formato se comprueba dentro de `verify`, no como orden aparte que haya que acordarse de
        ejecutar: así la CI lo exige con el mismo comando que ya corre los tests.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <importOrder/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>comprobar-formato</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Cobertura: se MIDE y no se exige. Deliberadamente sin `check` y sin umbral.

        La convención de la biblioteca dice que la cobertura sirve para revelar huecos y no como fin
        en sí mismo, y un umbral en el build convierte lo segundo en obligatorio: a partir del día en
        que rompe, la forma barata de arreglarlo es escribir tests que recorran código sin afirmar
        nada, que suben el número y no protegen de nada. El informe queda en
        `target/site/jacoco/index.html` para leerlo cuando se quiera saber qué NO se está probando.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>preparar-el-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>informe-de-cobertura</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Arranca el backend en local con su propio PostgreSQL, sin Docker y sin instalar nada:

          ./mvnw spring-boot:run -Parranque-local

      Existe porque en este equipo no hay Docker y el servidor JPA de HAPI no levanta el contexto
      sin base de datos, así que sin esto la web del profesional no se puede ejercitar contra la API
      hasta el `docker compose` del ítem 15. La clase que lo hace vive en `src/test`, que es donde
      está el PostgreSQL embebido: NO es un modo de despliegue, y la base de datos se crea vacía en
      un temporal y desaparece al parar el proceso.

      Va como perfil y no como `-D` en la orden porque `useTestClasspath` se ignora al pasarlo por
      línea de órdenes; en la configuración del plugin sí se aplica.
    -->
    <profile>
      <id>arranque-local</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <mainClass>es.hispalis.backend.ArranqueLocal</mainClass>
              <useTestClasspath>true</useTestClasspath>
              <!--
                `useTestClasspath` trae las dependencias de alcance `test` —el PostgreSQL
                embebido—, pero no las clases compiladas de `src/test`, así que la clase de arranque
                hay que añadirla aparte. Sin esta línea el fallo es un `ClassNotFoundException` de
                esa misma clase, que no apunta a su causa.
              -->
              <additionalClasspathElements>
                <additionalClasspathElement>${project.build.testOutputDirectory}</additionalClasspathElement>
              </additionalClasspathElements>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
