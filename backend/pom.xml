<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backend de HispaLIS: núcleo de dominio + API FHIR R5 + proyección HAPI.

  Sobre las versiones (§12 del diseño):
  · Spring Boot se mantiene en la línea 3.5.x a propósito, no por inercia. HAPI FHIR 8.x va sobre
    Spring Framework 6 y Jakarta EE 10; Spring Boot 4.x salta a Spring Framework 7 y Jakarta EE 11,
    que HAPI todavía no soporta. Subir a 4.x rompería el servidor JPA que sostiene la proyección.
  · La codificación es UTF-8 en todas partes y de forma explícita: MUÑOZ, ÁLVAREZ y PEÑA son casos
    de prueba obligatorios del proyecto, y un `platform default encoding` los corrompe en silencio.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>es.hispalis</groupId>
  <artifactId>hispalis-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>HispaLIS · backend</name>
  <description>Sistema de Información de Laboratorio sobre HL7 FHIR R5</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <hapi-fhir.version>8.10.1</hapi-fhir.version>
    <embedded-postgres.version>2.1.0</embedded-postgres.version>
    <spotless.version>2.44.5</spotless.version>

    <!--
      Spring Boot 3.5.16 gestiona commons-lang3 en la 3.17.0 y HAPI 8.10.1 necesita la 3.18.0, que
      es donde aparece `ObjectUtils.getIfNull(T, T)`. Gana el `dependencyManagement` del padre, así
      que hay que subirla aquí a mano.

      No es un fallo de compilación: los dos son compatibles al compilar y el conflicto solo estalla
      en ejecución, con un `NoSuchMethodError` al servir la primera petición. Al actualizar Spring
      Boot, comprobar si ya alcanza a HAPI y quitar esta línea.
    -->
    <commons-lang3.version>3.18.0</commons-lang3.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Modelo FHIR R5 y SOLO R5. Si un import trae `…model.r4…`, está mal (backend/CLAUDE.md). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r5</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <!--
      El servidor JPA de HAPI es la proyección de lectura (§9 del diseño): da búsqueda por
      SearchParameter, _include, paginación por Bundle.link, _history, ETag/versionId y $validate.
      Se empotra en esta aplicación —no se usa `hapi-fhir-jpaserver-starter`, que es una aplicación
      aparte— porque la proyección tiene que escribirse en la MISMA transacción que el dominio.
    -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-jpaserver-base</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway gobierna el esquema `dominio`. `flyway-core` llega transitivo desde HAPI, pero desde
      Flyway 10 el soporte de cada motor va en su propio artefacto: sin este, aborta el arranque con
      «Unsupported Database: PostgreSQL 14.15», culpando a la base de datos en vez de al módulo.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      PostgreSQL de verdad en los tests, arrancado en proceso desde un binario: mismo motor y mismo
      dialecto que producción, sin necesitar Docker. Ver la decisión del ítem 6 en docs/PLAN.md.
    -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        El formato se comprueba dentro de `verify`, no como orden aparte que haya que acordarse de
        ejecutar: así la CI lo exige con el mismo comando que ya corre los tests.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <importOrder/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>comprobar-formato</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Arranca el backend en local con su propio PostgreSQL, sin Docker y sin instalar nada:

          ./mvnw spring-boot:run -Parranque-local

      Existe porque en este equipo no hay Docker y el servidor JPA de HAPI no levanta el contexto
      sin base de datos, así que sin esto la web del profesional no se puede ejercitar contra la API
      hasta el `docker compose` del ítem 15. La clase que lo hace vive en `src/test`, que es donde
      está el PostgreSQL embebido: NO es un modo de despliegue, y la base de datos se crea vacía en
      un temporal y desaparece al parar el proceso.

      Va como perfil y no como `-D` en la orden porque `useTestClasspath` se ignora al pasarlo por
      línea de órdenes; en la configuración del plugin sí se aplica.
    -->
    <profile>
      <id>arranque-local</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <mainClass>es.hispalis.backend.ArranqueLocal</mainClass>
              <useTestClasspath>true</useTestClasspath>
              <!--
                `useTestClasspath` trae las dependencias de alcance `test` —el PostgreSQL
                embebido—, pero no las clases compiladas de `src/test`, así que la clase de arranque
                hay que añadirla aparte. Sin esta línea el fallo es un `ClassNotFoundException` de
                esa misma clase, que no apunta a su causa.
              -->
              <additionalClasspathElements>
                <additionalClasspathElement>${project.build.testOutputDirectory}</additionalClasspathElement>
              </additionalClasspathElements>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
