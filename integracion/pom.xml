<?xml version="1.0" encoding="UTF-8"?>
<!--
  Motor de integración de HispaLIS: canales HL7 V2.5.1 sobre MLLP.

  Sobre las versiones:
  · Spring Boot en la línea 3.5.x, la misma que el backend, y por la misma razón: HAPI FHIR 8.x va
    sobre Spring Framework 6 / Jakarta EE 10. Aquí no hay servidor JPA de HAPI, pero sí su cliente
    FHIR, y tener dos líneas distintas entre los dos servicios sería una fuente de sorpresas gratis.
  · La codificación es UTF-8 explícita en todas partes. MUÑOZ, ÁLVAREZ y PEÑA son casos de prueba
    obligatorios y este es EL componente donde se rompen: un `platform default encoding` en la
    compilación los corrompe antes incluso de que llegue el primer mensaje.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>es.hispalis</groupId>
  <artifactId>hispalis-integracion</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>HispaLIS · motor de integración</name>
  <description>Canales HL7 V2.5.1 sobre MLLP hacia la API FHIR R5 del laboratorio</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <hapi-hl7v2.version>2.6.0</hapi-hl7v2.version>
    <hapi-fhir.version>8.10.1</hapi-fhir.version>
    <embedded-postgres.version>2.1.0</embedded-postgres.version>
    <spotless.version>2.44.5</spotless.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!--
      HAPI HL7v2: parser, listener MLLP y generación de acuses (D11, ADR-0005). El *framing*
      (0x0B … 0x1C 0x0D) lo implementa esta librería y NUNCA se escribe a mano: el documento
      normativo de MLLP está retirado desde mayo de 2025 y lo que falta es fuente citable, no código.
    -->
    <dependency>
      <groupId>ca.uhn.hapi</groupId>
      <artifactId>hapi-base</artifactId>
      <version>${hapi-hl7v2.version}</version>
    </dependency>

    <!--
      SOLO las estructuras de V2.5.1 (D12). Traer también las de V2.5 dejaría que un mensaje con
      `MSH-12 = 2.5` se parsease sin queja, y las dos versiones NO son intercambiables: la tabla 0354
      cambia entre ellas (ver `docs/adr/adr-0018-…`).
    -->
    <dependency>
      <groupId>ca.uhn.hapi</groupId>
      <artifactId>hapi-structures-v251</artifactId>
      <version>${hapi-hl7v2.version}</version>
    </dependency>

    <!-- El modelo FHIR R5 con el que se construye lo que se envía. Solo R5. -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r5</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <!--
      El cliente FHIR. El motor escribe por la API del laboratorio como un cliente más (D5), así que
      usa un cliente FHIR de verdad y no un `RestClient` con JSON a mano: las mismas cabeceras, la
      misma negociación de contenido y los mismos `OperationOutcome` que cualquier otro cliente.
    -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-client</artifactId>
      <version>${hapi-fhir.version}</version>
    </dependency>

    <!--
      El almacén de mensajes va en SQL explícito, como en el backend: es una bitácora indexable, no
      un grafo de objetos. Su esquema es del motor y NO se toca el del backend (D5).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- Desde Flyway 10 el soporte de cada motor va en su propio artefacto. Ver el POM del backend. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- El formato se comprueba dentro de `verify`, igual que en el backend. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <importOrder/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>comprobar-formato</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
