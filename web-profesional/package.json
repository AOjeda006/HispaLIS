{
  "name": "hispalis-web-profesional",
  "version": "0.1.0",
  "description": "Web del profesional del laboratorio de HispaLIS: alta de petición y consulta de informe",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
